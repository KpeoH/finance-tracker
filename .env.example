# Database
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name
POSTGRES_PORT=port

DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:your_port/fin_tracker_db
